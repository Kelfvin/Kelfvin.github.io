	loading=&#34;lazy&#34;
	
	
		class=&#34;gallery-image&#34; 
		data-flex-grow=&#34;144&#34;
		data-flex-basis=&#34;346px&#34;
	
&gt;
&lt;img src=&#34;https://kelfvin.github.io/post/3%E6%9C%88%E6%80%BB%E7%BB%93/cat.jpg&#34;
	width=&#34;4792&#34;
	height=&#34;3712&#34;
	srcset=&#34;https://kelfvin.github.io/post/3%E6%9C%88%E6%80%BB%E7%BB%93/cat_hu_e847cb62111cff9c.jpg 480w, https://kelfvin.github.io/post/3%E6%9C%88%E6%80%BB%E7%BB%93/cat_hu_882941aa16ea4f64.jpg 1024w&#34;
